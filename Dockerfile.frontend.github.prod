# Multi-stage build for production frontend from GitHub
# Stage 1: Build the application
FROM node:20-alpine AS builder

WORKDIR /app

# Install git (needed to clone from GitHub)
RUN apk add --no-cache git

# Clone the frontend repository from GitHub
# Replace with your GitHub repository URL
ARG GITHUB_REPO_URL
ARG GITHUB_BRANCH=main
ARG GITHUB_TOKEN=

# Clone the repository
# Handle both formats: username/repo or full URL
RUN if [ -n "$GITHUB_TOKEN" ]; then \
        if echo "$GITHUB_REPO_URL" | grep -q "^https://"; then \
            REPO_URL="https://${GITHUB_TOKEN}@${GITHUB_REPO_URL#https://}"; \
        else \
            REPO_URL="https://${GITHUB_TOKEN}@github.com/${GITHUB_REPO_URL}.git"; \
        fi && \
        git clone -b ${GITHUB_BRANCH} "$REPO_URL" .; \
    else \
        if echo "$GITHUB_REPO_URL" | grep -q "^https://"; then \
            git clone -b ${GITHUB_BRANCH} ${GITHUB_REPO_URL} .; \
        else \
            git clone -b ${GITHUB_BRANCH} https://github.com/${GITHUB_REPO_URL}.git .; \
        fi; \
    fi

# Install dependencies
RUN npm install

# Build arguments for environment variables
ARG VITE_API_URL=http://localhost:8000
ARG VITE_GEMINI_API_KEY=
ARG VITE_GOOGLE_CLIENT_ID=

# Set environment variables for build
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_GEMINI_API_KEY=$VITE_GEMINI_API_KEY
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

# Build the application
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy built files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration (if your repo has one, otherwise use default)
# If your GitHub repo has nginx.conf, uncomment the next line:
# COPY --from=builder /app/nginx.conf /etc/nginx/conf.d/default.conf

# Use default nginx config for SPA (fallback to index.html)
RUN echo 'server { \
    listen 80; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

