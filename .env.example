# ============================================
# Environment Variables Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=msp_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
POSTGRES_DB=msp_db

# Database connection URL (auto-constructed from above, or set directly)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://msp_user:CHANGE_THIS_TO_STRONG_PASSWORD@postgres:5432/msp_db

# ============================================
# JWT Authentication
# ============================================
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Or: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_KEY_MIN_32_CHARACTERS

# Token expiration time in minutes (default: 30 days = 43200 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ============================================
# Frontend Configuration
# ============================================
# API URL for frontend (adjust based on your deployment)
VITE_API_URL=http://localhost:8000

# ============================================
# Optional: Gemini AI (for AI Assistant feature)
# ============================================
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://10.0.1.122:5173,http://10.0.1.122:3000,http://frontend:5173
API_RATE_LIMIT=100/minute
AUTH_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/hour

# ============================================
# Rate Limiting Configuration
# ============================================
# General API rate limit (requests per time period)
API_RATE_LIMIT=100/minute

# Authentication endpoints rate limit (stricter)
AUTH_RATE_LIMIT=5/minute

# Registration endpoint rate limit (very strict to prevent abuse)
REGISTER_RATE_LIMIT=3/hour

# ============================================
# Gunicorn Configuration
# ============================================
# Number of worker processes (default: 4, formula: (2 x CPU cores) + 1)
# For production, adjust based on server resources
GUNICORN_WORKERS=4

# Log level (debug, info, warning, error, critical)
LOG_LEVEL=info

# ============================================
# Frontend API Configuration
# ============================================
# Frontend API base URL (no hardcoded IPs - use environment variables)
# Examples:
#   Development: http://localhost:8000
#   Production: https://api.yourdomain.com
#   Docker: http://backend:8000
VITE_API_URL=http://localhost:8000

# ============================================
# Sentry Error Tracking (Optional)
# ============================================
# Sentry DSN for error tracking
# Get from https://sentry.io/ - create a project and copy the DSN
# Leave empty to disable Sentry
SENTRY_DSN=

# Environment name (development, staging, production)
ENVIRONMENT=development

# Release version (optional, for tracking deployments)
RELEASE_VERSION=

# Sentry performance monitoring
# Sample rate for transactions (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Sample rate for profiling (0.0 to 1.0)
SENTRY_PROFILES_SAMPLE_RATE=0.1

# For production with domain (peres.systems)
# CORS_ORIGINS=https://peres.systems,https://www.peres.systems,http://localhost:5173,http://localhost:3000,http://frontend:5173
